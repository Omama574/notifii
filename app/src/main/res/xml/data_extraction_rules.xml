<?xml version="1.0" encoding="utf-8"?>
<!-- The Vault never goes to cloud backup. Moving to a new phone (direct device transfer) keeps your ladder and Vault. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
</data-extraction-rules>
